# Copy to terraform.tfvars and fill in. Only project_id is required.

# ── GCP ───────────────────────────────────────────────────────────────────────
project_id = "your-gcp-project-id"
region     = "us-central1"

# ── Google Workspace ─────────────────────────────────────────────────────────
# Must be a real, active, licensed admin user in your Workspace tenant.
delegated_admin_email = "workspace-admin@your-domain.com"

# Gemini Enterprise license subscription — normally chosen on the Settings page.
# Optional headless default (a Discovery Engine license config resource name):
# license_config = "projects/123456789/locations/us/licenseConfigs/free_trial_gemini"

# ── Cloud Scheduler ─────────────────────────────────────────────────────────
initial_cron_expression = "0 2 * * *"   # UTC

# ── GitHub (Workload Identity Federation) ───────────────────────────────────
# Leave "" to skip creating WIF resources.
github_repo = "my-org/gemini-license-provisioner"

# ── Optional resource names (defaults shown; override only if you must) ──────
# service_name                = "gemini-license-provisioner"
# app_service_account_id       = "sa-gemini-provisioner"
# scheduler_service_account_id = "sa-scheduler-invoker"
# artifact_repository_id       = "gemini-provisioner-docker"
# scheduler_job_name           = "gemini-license-sync-job"
